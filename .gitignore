# This Git ignore file should be placed at the root of your Unity project directory
# https://github.com/github/gitignore/blob/main/Unity.gitignore

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/

# MemoryCaptures can get large and are generally local to the machine
[Mm]emoryCaptures/

# Asset meta data should only be ignored for specific workflows
# !*.meta

# Uncomment this line if you prefer to ignore the cache server
# [Cc]acheServer/

# Autogenerated VS/MonoDevelop/JetBrains Rider files
ExportedObj/
.vs/
.idea/
.generated/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for packages that are not local should be ignored
/[Pp]ackages/[Mm]anifest.json
/Packages/packages-lock.json

# Autogenerated crash dump files
unity_crash_report/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
